# Copie para `.env` (ignorado pelo git). Nenhum valor abaixo é um segredo real.
# Obrigatórias: nenhuma para subir a API (os padrões bastam para desenvolvimento local).
# Em staging/production defina, no mínimo, APP_ENVIRONMENT e o ENDPOINT_URL (https) do serviço SOAP.

# ── Aplicação (opcionais) ─────────────────────────────────────────────────────
APP_ENVIRONMENT=local            # local | test | staging | production
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
OTEL_SERVICE_NAME=sap-gateway    # nome do serviço em traces/métricas/logs
# APP_SERVICE_VERSION=            # vazio = versão do pacote
# APP_BASIC_AUTH_REALM=sap-gateway

# ── Serviço SOAP "maintenance_notification" ───────────────────────────────────
# Padrão: WSDL empacotado + soap:address do WSDL. Em ambientes reais, aponte para o SAP.
# O consumidor da API NUNCA informa URLs: destinos vêm somente desta configuração.
APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__ENDPOINT_URL=http://127.0.0.1:8081/soap/maintenance-notification
# APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__WSDL=/caminho/ou/https://host/wsdl   # padrão: empacotado
# APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__AUTH_MODE=http_basic                 # http_basic | ws_security_username_token | none
APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__CONNECT_TIMEOUT_SECONDS=5
APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__READ_TIMEOUT_SECONDS=30
# APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__WSDL_TIMEOUT_SECONDS=15
APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__RETRY__MAX_ATTEMPTS=3
APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__RETRY__BACKOFF_BASE_SECONDS=0.2
APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__RETRY__BACKOFF_MAX_SECONDS=2
# TLS (padrão: verificação ligada)
# APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__TLS__VERIFY=true
# APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__TLS__CA_BUNDLE=/etc/ssl/corp-ca.pem
# APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__TLS__CLIENT_CERT=/etc/ssl/client.pem
# APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__TLS__CLIENT_KEY=/etc/ssl/client.key
# APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__PROXY_URL=http://proxy.corp:3128
# Hosts extras autorizados para imports de WSDL/XSD (lista separada por vírgulas):
# APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__ALLOWED_HOSTS=schemas.corp.example
# Credencial TÉCNICA usada só para baixar WSDL/XSD protegidos por URL (nunca para chamadas de negócio).
# Prefira WSDL local. Injete o segredo pelo cofre/orquestrador, não por arquivo versionado.
# APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__WSDL_USERNAME=
# APP_SOAP_SERVICES__MAINTENANCE_NOTIFICATION__WSDL_PASSWORD=

# ── OpenTelemetry (exportação OTLP para o Grafana Alloy) ──────────────────────
# Os três sinais são independentes e vêm DESLIGADOS por padrão (a API sobe sem nenhum backend).
APP_OTEL_TRACES_ENABLED=true
APP_OTEL_METRICS_ENABLED=true
APP_OTEL_LOGS_ENABLED=true
OTEL_EXPORTER_OTLP_PROTOCOL=grpc                 # grpc (4317) | http/protobuf (4318)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_TIMEOUT=5000                  # ms, por exportação
OTEL_METRIC_EXPORT_INTERVAL=15000                # ms
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer ...   # tratado como segredo
# APP_OTEL_BATCH_SCHEDULE_DELAY_MS=2000
# APP_OTEL_SHUTDOWN_TIMEOUT_MS=3000
# APP_OTEL_HTTP_METRICS_ENABLED=true
# APP_OTEL_HTTP_EXCLUDED_URLS=/health/live,/health/ready,/docs,/redoc,/openapi.json

# ── Mock SAP (apenas desenvolvimento/demonstração: `uv run mock-sap`) ─────────
# Formato: usuario:senha,outro:senha. Troque por valores locais; não reutilize senhas reais.
MOCK_SAP_USERS=alice:troque-me,bob:troque-me-tambem
# MOCK_SAP_HOST=127.0.0.1
# MOCK_SAP_PORT=8081
# MOCK_SAP_SLOW_SECONDS=5

# ── Docker Compose (observabilidade local; portas só em 127.0.0.1) ───────────
# ALLOY_OTLP_GRPC_PORT=4317
# ALLOY_OTLP_HTTP_PORT=4318
# ALLOY_UI_PORT=12345
# TEMPO_PORT=3200
# LOKI_PORT=3100
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin     # apenas desenvolvimento
# APP_PORT=8000
# MOCK_SAP_PORT=8081
