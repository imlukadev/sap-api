      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (username, soap_service, soap_operation) (count_over_time({service_name=\"sap-gateway\", deployment_environment=~\"$env\"} |= \"soap call\" | soap_operation!=\"\" | username=~\"$username\" | username!=\"\" [$__range]))",
          "legendFormat": "",
