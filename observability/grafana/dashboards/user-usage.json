      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{service_name=\"sap-gateway\", deployment_environment=~\"$env\"} |= \"http request completed\" | username=~\"$username\" | username!=\"\" | http_route=~\"$route\"",
          "queryType": "range",
