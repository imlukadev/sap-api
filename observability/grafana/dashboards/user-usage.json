    },
    {
      "type": "timeseries",
      "title": "Latência p95 por usuário",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "quantile_over_time(0.95, {service_name=\"sap-gateway\", deployment_environment=~\"$env\"} |= \"http request completed\" | username=~\"$username\" | username!=\"\" | unwrap duration_ms [$__interval]) by (username)",
          "legendFormat": "{{username}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
