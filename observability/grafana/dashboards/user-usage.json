        "y": 27,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Traces do usuário (Tempo / TraceQL)",
      "description": "Cada linha é um trace; abra para ver a sequência HTTP → SOAP → HTTP do SAP.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{ span.enduser.id =~ \"$username\" && kind = server }",
          "limit": 50,
          "tableType": "traces",
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
