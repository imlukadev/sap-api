<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="urn:example:sap:pm:notification:v1"
                  name="MaintenanceNotificationService"
                  targetNamespace="urn:example:sap:pm:notification:v1">

  <wsdl:types>
    <xsd:schema>
      <xsd:import namespace="urn:example:sap:pm:notification:v1"
                  schemaLocation="maintenance_notification.xsd"/>
    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="NotificationReadIn"><wsdl:part name="parameters" element="tns:NotificationReadRequest"/></wsdl:message>
  <wsdl:message name="NotificationReadOut"><wsdl:part name="parameters" element="tns:NotificationReadResponse"/></wsdl:message>
  <wsdl:message name="NotificationCreateIn"><wsdl:part name="parameters" element="tns:NotificationCreateRequest"/></wsdl:message>
  <wsdl:message name="NotificationCreateOut"><wsdl:part name="parameters" element="tns:NotificationCreateResponse"/></wsdl:message>
  <wsdl:message name="NotificationSearchIn"><wsdl:part name="parameters" element="tns:NotificationSearchRequest"/></wsdl:message>
  <wsdl:message name="NotificationSearchOut"><wsdl:part name="parameters" element="tns:NotificationSearchResponse"/></wsdl:message>
  <wsdl:message name="NotificationFaultMsg"><wsdl:part name="fault" element="tns:NotificationFault"/></wsdl:message>

  <wsdl:portType name="MaintenanceNotificationPortType">
    <wsdl:operation name="NotificationRead">
      <wsdl:input message="tns:NotificationReadIn"/>
      <wsdl:output message="tns:NotificationReadOut"/>
      <wsdl:fault name="NotificationFault" message="tns:NotificationFaultMsg"/>
    </wsdl:operation>
    <wsdl:operation name="NotificationCreate">
      <wsdl:input message="tns:NotificationCreateIn"/>
      <wsdl:output message="tns:NotificationCreateOut"/>
      <wsdl:fault name="NotificationFault" message="tns:NotificationFaultMsg"/>
    </wsdl:operation>
    <wsdl:operation name="NotificationSearch">
      <wsdl:input message="tns:NotificationSearchIn"/>
      <wsdl:output message="tns:NotificationSearchOut"/>
      <wsdl:fault name="NotificationFault" message="tns:NotificationFaultMsg"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="MaintenanceNotificationBinding" type="tns:MaintenanceNotificationPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="NotificationRead">
      <soap:operation soapAction="urn:example:sap:pm:notification:v1:NotificationRead"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="NotificationFault"><soap:fault name="NotificationFault" use="literal"/></wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="NotificationCreate">
      <soap:operation soapAction="urn:example:sap:pm:notification:v1:NotificationCreate"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="NotificationFault"><soap:fault name="NotificationFault" use="literal"/></wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="NotificationSearch">
      <soap:operation soapAction="urn:example:sap:pm:notification:v1:NotificationSearch"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="NotificationFault"><soap:fault name="NotificationFault" use="literal"/></wsdl:fault>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="MaintenanceNotificationService">
    <wsdl:port name="MaintenanceNotificationPort" binding="tns:MaintenanceNotificationBinding">
      <soap:address location="http://localhost:8081/soap/maintenance-notification"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
